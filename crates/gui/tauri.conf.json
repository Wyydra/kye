{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kye",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd $(git rev-parse --show-toplevel)/frontend && bun dev",
    "beforeBuildCommand": "cd $(git rev-parse --show-toplevel)/frontend && bun build"
  },
  "app": {
    "windows": [
      {
        "title": "Kye",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}